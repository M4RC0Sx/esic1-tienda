{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_data.py\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking data/ is read-only..."
          }
        ]
      }
    ]
  }
}
